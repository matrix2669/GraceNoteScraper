# GraceNote / TMS lineup configuration
# Leave GN_HEADEND, GN_LINEUP, and GN_ZIPCODE empty to choose a provider at
# http://<your-host>:8080/setup. Complete GN_* settings remain supported as a
# bootstrap for existing deployments.
GN_HEADEND = ""
GN_LINEUP = ""
GN_COUNTRY = "USA"
GN_ZIPCODE = ""
GN_LANGUAGE = "en-us"
GN_DEVICE = "-"

# Path for the non-secret lineup selection saved by /setup.
CONFIG_PATH = "config.json"

# Persistent evidence for on-demand provider scans in the configured ZIP.
# Legacy setting name retained so existing evidence remains usable.
MARKET_INDEX_PATH = "market_index.json"
# Runtime-generated per-lineup identity/category files. Blank stores them in a
# lineup_snapshots directory beside MARKET_INDEX_PATH.
LINEUP_SNAPSHOT_DIR = ""

# Lineuparr builder state and public-source cache. Every active provider
# channel is retained by default; this state records only your exclusions and
# category edits for the current lineup fingerprint.
LINEUPARR_STATE_PATH = "lineuparr_state.json"
LINEUPARR_CACHE_DIR = "lineuparr_source_cache"

# Optional reference sources. Runtime configured-ZIP evidence is the default.
# Set LINEUPARR_CATALOG_URLS to "default" for the old mapped Lineuparr catalogs
# or to comma-separated JSON URLs. Set LINEUPARR_IPTV_ORG_URL explicitly to use
# that database. Set LINEUPARR_REFERENCE_CATALOGS=on to enable the embedded
# provider, PrismCast, and PBS snapshots. All three are off by default.
LINEUPARR_CATALOG_URLS = ""
LINEUPARR_IPTV_ORG_URL = ""
LINEUPARR_REFERENCE_CATALOGS = ""

# Legacy API-only OpenStreetMap/Nominatim endpoint (not used by the current UI).
# Google Maps copy/paste and Save & test work without this or any Google API key.
# The public default is no-key, permits explicit searches only, and is limited
# to one request per second. Use a hosted/self-managed endpoint for private
# addresses, or set this to "off" to disable provider-address search.
NOMINATIM_URL = "https://nominatim.openstreetmap.org"

# TMDB read-access token (optional — enables poster images and metadata)
# Get one at https://www.themoviedb.org/settings/api
TMDB_TOKEN = ""

# Base URL of the server (optional — rewrites image URLs in XMLTV to use the
# built-in image proxy cache instead of hitting remote hosts directly)
# Example: http://192.168.1.50:8080
BASE_URL = ""

# Jellyfin Live TV integration (optional — embeds a live video player in The Grid)
# Channels are matched by channel number between the guide and Jellyfin.
JELLYFIN_URL = ""
JELLYFIN_API_KEY = ""

# Filter guide to only show channels available in Jellyfin (optional)
# Set to any non-empty value to enable. Requires JELLYFIN_URL and JELLYFIN_API_KEY.
JELLYFIN_CHANNEL_FILTER = ""
