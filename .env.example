# Docker image channel used by docker-compose.yml. Keep dev-test for the
# testing branch. Change this to dev after those changes are promoted.
GRACENOTESCRAPER_IMAGE_TAG = "dev-test"

# Path for the non-secret lineup selection saved by /setup.
CONFIG_PATH = "config.json"

# Optional TMDB read-access token. Adding one enriches programmes with poster
# artwork, star ratings, release years, original languages, TMDB identifiers,
# and descriptions when Gracenote reports them as unavailable. The guide,
# lineup setup, aliases, categories, and XMLTV output work without this token.
# Get one at https://www.themoviedb.org/settings/api
TMDB_TOKEN = ""

# Base URL of the server (optional — rewrites image URLs in XMLTV to use the
# built-in image proxy cache instead of hitting remote hosts directly)
# Example: http://192.168.1.50:8080
BASE_URL = ""

# Jellyfin Live TV integration (optional — embeds a live video player in The Grid)
# Channels are matched by channel number between the guide and Jellyfin.
JELLYFIN_URL = ""
JELLYFIN_API_KEY = ""

# Filter guide to only show channels available in Jellyfin (optional)
# Set to any non-empty value to enable. Requires JELLYFIN_URL and JELLYFIN_API_KEY.
JELLYFIN_CHANNEL_FILTER = ""
