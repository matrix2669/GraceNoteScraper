<?xml version="1.0" ?>
<!DOCTYPE tv SYSTEM 'xmltv.dtd'>
<tv source-info="http://tvlistings.gracenote.com/" source-info-name="GraceNote" generator-info-name="GraceNoteScraper">
{{- range .Channels }}
  <channel id="{{ .ID }}">
    {{- range .DisplayNames }}
    <display-name>{{ .Name }}</display-name>
    {{- end }}
    <icon src="{{ .IconURL }}" />
  </channel>
{{- end }}
{{- range .Programs }}
  <programme start="{{ .Start }}" stop="{{ .Stop }}" channel="{{ .Channel }}">
    <title lang="{{ .Lang }}">{{ .Title }}</title>
    {{- if .SubTitle }}
    <sub-title lang="{{ .Lang }}">{{ .SubTitle }}</sub-title>
    {{- end }}
    <desc lang="{{ .Lang }}">{{ .Description }}</desc>
    <length units="{{ .LengthUnits }}">{{ .Length }}</length>
    {{- if .Language }}
    <language>{{ .Language }}</language>
    {{- end }}
    {{- if .OrigLanguage }}
    <orig-language>{{ .OrigLanguage }}</orig-language>
    {{- end }}
    {{- if .HasTMDBCredits }}
    {{- with .TMDBCredits }}
    <credits>
      {{- range .Directors }}
      <director>{{ . }}</director>
      {{- end }}
      {{- range .Actors }}
      <actor>{{ . }}</actor>
      {{- end }}
    </credits>
    {{- end }}
    {{- end }}
    {{- if .IconSrc }}
    <icon src="{{ .IconSrc }}"/>
    {{- end }}
    {{- range .EnrichedImages }}
    <image type="{{ .Type }}" size="{{ .Size }}" orient="{{ .Orient }}" system="{{ .System }}">{{ .URL }}</image>
    {{- end }}
    <url>{{ .URL }}</url>
    {{- if .Country }}
    <country>{{ .Country }}</country>
    {{- end }}
    {{- range .EnrichedEpisodeNumbers }}
    <episode-num system="{{ .System }}">{{ .EpisodeNumber }}</episode-num>
    {{- end }}
    {{- range .EnrichedCategories }}
    <category lang="{{ .Lang }}">{{ .Name }}</category>
    {{- end }}
    {{- range .TMDBKeywords }}
    <keyword>{{ . }}</keyword>
    {{- end }}
    {{- if .New }}
    <new />
    {{- end }}
    {{- if .Premiere }}
    <premiere />
    {{- end }}
    {{- if .PreviouslyShown }}
    <previously-shown />
    {{- end }}
    {{- range .Subtitles }}
    <subtitles type="{{ .Type }}" />
    {{- end }}
    {{- if .EffectiveRating }}
    <rating{{ if .EffectiveRatingSystem }} system="{{ .EffectiveRatingSystem }}"{{ end }}><value>{{ .EffectiveRating }}</value></rating>
    {{- end }}
    {{- if .StarRating }}
    <star-rating><value>{{ .StarRating }}</value></star-rating>
    {{- end }}
    {{- if .EffectiveDate }}
    <date>{{ .EffectiveDate }}</date>
    {{- end }}
  </programme>
{{- end }}
</tv>
