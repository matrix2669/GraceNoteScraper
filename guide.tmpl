<?xml version="1.0" ?>
<!DOCTYPE tv SYSTEM 'xmltv.dtd'>
<tv source-info="http://tvlistings.gracenote.com/" source-info-name="GraceNote" generator-info-name="GraceNoteScraper">
{{- range .Channels }}
  <channel id="{{ .ID }}">
    {{- range .DisplayNames }}
    <display-name>{{ .Name }}</display-name>
    {{- end }}
    <icon src="{{ .IconURL }}" />
  </channel>
{{- end }}
{{- range .Programs }}
  <programme start="{{ .Start }}" stop="{{ .Stop }}" channel="{{ .Channel }}">
    <title lang="{{ .Lang }}">{{ .Title }}</title>
    {{- if .SubTitle }}
    <sub-title lang="{{ .Lang }}">{{ .SubTitle }}</sub-title>
    {{- end }}
    {{- with .TMDBCredits }}
    <credits>
      {{- range . }}
      {{- if eq .Role "director" }}
      <director>{{ .Name }}</director>
      {{- else if eq .Role "actor" }}
      <actor>{{ .Name }}</actor>
      {{- else if eq .Role "writer" }}
      <writer>{{ .Name }}</writer>
      {{- else }}
      <producer>{{ .Name }}</producer>
      {{- end }}
      {{- end }}
    </credits>
    {{- end }}
    <desc lang="{{ .Lang }}">{{ .Description }}</desc>
    <length units="{{ .LengthUnits }}">{{ .Length }}</length>
    {{- if .Language }}
    <language>{{ .Language }}</language>
    {{- end }}
    {{- if .OrigLanguage }}
    <orig-language>{{ .OrigLanguage }}</orig-language>
    {{- end }}
    {{- if .IconSrc }}
    <icon src="{{ .IconSrc }}"/>
    {{- end }}
    {{- range .Images }}
    <image type="{{ .Type }}" size="{{ .Size }}" orient="{{ .Orient }}" system="{{ .System }}">{{ .URL }}</image>
    {{- end }}
    {{- range .TMDBImages }}
    <image type="{{ .Type }}" size="{{ .Size }}" orient="{{ .Orient }}" system="{{ .System }}">{{ .URL }}</image>
    {{- end }}
    <url>{{ .URL }}</url>
    {{- if .Country }}
    <country>{{ .Country }}</country>
    {{- end }}
    {{- range .EpisodeNumbers }}
    <episode-num system="{{ .System }}">{{ .EpisodeNumber }}</episode-num>
    {{- end }}
    {{- range .TMDBEpisodeNumbers }}
    <episode-num system="{{ .System }}">{{ .EpisodeNumber }}</episode-num>
    {{- end }}
    {{- range .Categories }}
    <category lang="{{ .Lang }}">{{ .Name }}</category>
    {{- end }}
    {{- range .TMDBCategories }}
    <category lang="{{ .Lang }}">{{ .Name }}</category>
    {{- end }}
    {{- range .TMDBKeywords }}
    <keyword>{{ . }}</keyword>
    {{- end }}
    {{- if .New }}
    <new />
    {{- end }}
    {{- if .Premiere }}
    <premiere />
    {{- end }}
    {{- if .PreviouslyShown }}
    <previously-shown />
    {{- end }}
    {{- range .Subtitles }}
    <subtitles type="{{ .Type }}" />
    {{- end }}
    {{- if .Rating }}
    <rating{{ if .RatingSystem }} system="{{ .RatingSystem }}"{{ end }}><value>{{ .Rating }}</value></rating>
    {{- else }}
      {{- with .TMDBRating }}
    <rating system="{{ .System }}"><value>{{ .Value }}</value></rating>
      {{- end }}
    {{- end }}
    {{- if .StarRating }}
    <star-rating><value>{{ .StarRating }}</value></star-rating>
    {{- end }}
    {{- if .TMDBDate }}
    <date>{{ .TMDBDate }}</date>
    {{- else if .Date }}
    <date>{{ .Date }}</date>
    {{- end }}
  </programme>
{{- end }}
</tv>
